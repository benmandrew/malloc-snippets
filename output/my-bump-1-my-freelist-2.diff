+static void insert_free(chunk_t *c) {
+    chunk_t *prev = NULL;
+    chunk_t *next = free_list;
+    while (next != NULL && next < c) {
+        prev = next;
+        next = next->next;
+    }
+    c->next = next;
+    if (prev != NULL)
+        prev->next = c;
+    else
